{
    "name": "revspan",
    "displayName": "Revspan for Bitbucket",
    "description": "Relire les PR Bitbucket version par version, malgré amend, rebase et force-push, dans VS Code",
    "version": "2.0.0",
    "publisher": "theodoreguillet",
    "license": "MIT",
    "icon": "media/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/theodoreguillet/revspan.git"
    },
    "bugs": {
        "url": "https://github.com/theodoreguillet/revspan/issues"
    },
    "homepage": "https://github.com/theodoreguillet/revspan#readme",
    "pricing": "Free",
    "engines": {
        "vscode": "^1.95.0"
    },
    "categories": ["Other"],
    "keywords": ["bitbucket", "pull request", "code review", "amend", "rebase", "force push", "interdiff"],
    "galleryBanner": {
        "color": "#1f2b46",
        "theme": "dark"
    },
    "extensionKind": ["workspace"],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Dans un espace de travail non approuvé, la liste des dépôts suivis définie par l'espace de travail est ignorée.",
            "restrictedConfigurations": ["revspan.repositories"]
        },
        "virtualWorkspaces": {
            "supported": "limited",
            "description": "« Ouvrir le fichier » a besoin d'un dépôt cloné sur le disque ; le reste fonctionne."
        }
    },
    "main": "./dist/extension.cjs",
    "contributes": {
        "commands": [
            { "command": "revspan.openHome", "title": "Ouvrir l'accueil", "category": "Revspan", "icon": "$(home)" },
            { "command": "revspan.openPr", "title": "Ouvrir une PR (URL)", "category": "Revspan", "icon": "$(link-external)" },
            { "command": "revspan.openSettings", "title": "Réglages (jeton, dépôts)", "category": "Revspan", "icon": "$(gear)" },
            { "command": "revspan.refresh", "title": "Actualiser", "category": "Revspan", "icon": "$(refresh)" }
        ],
        "configuration": {
            "title": "Revspan",
            "properties": {
                "revspan.repositories": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "markdownDescription": "Dépôts Bitbucket dont les PR ouvertes apparaissent dans « Mes PR » : un `workspace/dépôt` (ou l'adresse du dépôt) par entrée. Aussi modifiable depuis ⚙ Réglages du panneau Revspan."
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                { "id": "revspan", "title": "Revspan", "icon": "media/icon.svg" }
            ]
        },
        "views": {
            "revspan": [
                { "id": "revspan.home", "name": "Mes PR" }
            ]
        },
        "viewsWelcome": [
            {
                "view": "revspan.home",
                "contents": "Aucun jeton Bitbucket valide.\n[Configurer le jeton](command:revspan.openSettings)",
                "when": "revspan.needsToken"
            },
            {
                "view": "revspan.home",
                "contents": "Aucun dépôt suivi.\n[Choisir les dépôts](command:revspan.openSettings)",
                "when": "revspan.noRepos && !revspan.needsToken"
            }
        ],
        "menus": {
            "view/title": [
                { "command": "revspan.refresh", "when": "view == revspan.home", "group": "navigation@1" },
                { "command": "revspan.openPr", "when": "view == revspan.home", "group": "navigation@2" },
                { "command": "revspan.openHome", "when": "view == revspan.home", "group": "navigation@3" },
                { "command": "revspan.openSettings", "when": "view == revspan.home", "group": "navigation@4" }
            ]
        }
    }
}
