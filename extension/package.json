{
    "name": "revspan",
    "displayName": "%displayName%",
    "description": "%description%",
    "version": "3.0.0",
    "publisher": "theodoreguillet",
    "license": "MIT",
    "icon": "media/icon.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/theodoreguillet/revspan.git"
    },
    "bugs": {
        "url": "https://github.com/theodoreguillet/revspan/issues"
    },
    "homepage": "https://github.com/theodoreguillet/revspan#readme",
    "pricing": "Free",
    "engines": {
        "vscode": "^1.95.0"
    },
    "categories": ["Other"],
    "keywords": ["bitbucket", "pull request", "code review", "amend", "rebase", "force push", "interdiff"],
    "galleryBanner": {
        "color": "#1f2b46",
        "theme": "dark"
    },
    "extensionKind": ["workspace"],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "%capabilities.untrustedWorkspaces%",
            "restrictedConfigurations": ["revspan.repositories", "revspan.review.requiredApprovalsByRepository", "revspan.review.followedContributors"]
        },
        "virtualWorkspaces": {
            "supported": "limited",
            "description": "%capabilities.virtualWorkspaces%"
        }
    },
    "activationEvents": ["onWebviewPanel:revspan"],
    "main": "./dist/extension.cjs",
    "l10n": "./l10n",
    "contributes": {
        "commands": [
            { "command": "revspan.openHome", "title": "%command.openHome%", "category": "%command.category%", "icon": "$(home)" },
            { "command": "revspan.openPr", "title": "%command.openPr%", "category": "%command.category%", "icon": "$(link-external)" },
            { "command": "revspan.openSettings", "title": "%command.openSettings%", "category": "%command.category%", "icon": "$(gear)" },
            { "command": "revspan.refresh", "title": "%command.refresh%", "category": "%command.category%", "icon": "$(refresh)" },
            { "command": "revspan.groupBy", "title": "%command.groupBy%", "category": "%command.category%", "icon": "$(list-tree)" },
            { "command": "revspan.followAuthor", "title": "%command.followAuthor%", "category": "%command.category%", "icon": "$(star-empty)" },
            { "command": "revspan.unfollowAuthor", "title": "%command.unfollowAuthor%", "category": "%command.category%", "icon": "$(star-full)" }
        ],
        "configuration": {
            "title": "Revspan",
            "properties": {
                "revspan.repositories": {
                    "type": "array",
                    "items": { "type": "string" },
                    "default": [],
                    "markdownDescription": "%configuration.repositories%"
                },
                "revspan.review.requiredApprovals": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20,
                    "default": 2,
                    "markdownDescription": "%configuration.requiredApprovals%"
                },
                "revspan.review.requiredApprovalsByRepository": {
                    "type": "object",
                    "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 20 },
                    "default": {},
                    "markdownDescription": "%configuration.requiredApprovalsByRepository%"
                },
                "revspan.review.followedContributors": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "uuid": { "type": "string" },
                            "displayName": { "type": "string" }
                        },
                        "required": ["uuid"]
                    },
                    "default": [],
                    "markdownDescription": "%configuration.followedContributors%"
                },
                "revspan.notifications.newPullRequest": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "%configuration.notifications.newPullRequest%"
                },
                "revspan.notifications.newVersion": {
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "%configuration.notifications.newVersion%"
                },
                "revspan.notifications.buildFailed": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "%configuration.notifications.buildFailed%"
                },
                "revspan.refreshIntervalMinutes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 120,
                    "default": 5,
                    "markdownDescription": "%configuration.refreshIntervalMinutes%"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                { "id": "revspan", "title": "Revspan", "icon": "media/icon.svg" }
            ]
        },
        "views": {
            "revspan": [
                { "id": "revspan.home", "name": "%view.home%" }
            ]
        },
        "viewsWelcome": [
            {
                "view": "revspan.home",
                "contents": "%welcome.noToken%",
                "when": "revspan.needsToken"
            },
            {
                "view": "revspan.home",
                "contents": "%welcome.noRepos%",
                "when": "revspan.noRepos && !revspan.needsToken"
            }
        ],
        "menus": {
            "view/title": [
                { "command": "revspan.refresh", "when": "view == revspan.home", "group": "navigation@1" },
                { "command": "revspan.openPr", "when": "view == revspan.home", "group": "navigation@2" },
                { "command": "revspan.openHome", "when": "view == revspan.home", "group": "navigation@3" },
                { "command": "revspan.openSettings", "when": "view == revspan.home", "group": "navigation@4" },
                { "command": "revspan.groupBy", "when": "view == revspan.home", "group": "navigation@5" }
            ],
            "view/item/context": [
                { "command": "revspan.followAuthor", "when": "view == revspan.home && viewItem == pr", "group": "revspan@1" },
                { "command": "revspan.unfollowAuthor", "when": "view == revspan.home && viewItem == pr-followed", "group": "revspan@1" }
            ],
            "commandPalette": [
                { "command": "revspan.followAuthor", "when": "false" },
                { "command": "revspan.unfollowAuthor", "when": "false" }
            ]
        }
    }
}
