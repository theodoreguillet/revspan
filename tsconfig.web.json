{
    "extends": ["@vue/tsconfig/tsconfig.dom.json", "./tsconfig.base.json"],
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo",
        "lib": ["ES2023", "DOM", "DOM.Iterable"],
        "types": ["vite/client"]
    },
    "include": ["src/web/**/*.ts", "src/web/**/*.vue", "src/shared/**/*.ts"]
}
