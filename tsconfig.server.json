{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
        "lib": ["ES2023"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "erasableSyntaxOnly": true,
        "rootDir": "src"
    },
    "include": ["src/server/**/*.ts", "src/shared/**/*.ts"]
}
