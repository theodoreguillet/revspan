{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "node"
        ]
    },
    "include": [
        "test/**/*.ts",
        "src/server/**/*.ts",
        "src/shared/**/*.ts",
        "src/web/lib/**/*.ts",
        "src/web/services/**/*.ts",
        "src/web/composables/**/*.ts",
        "vite.config.ts",
        "vitest.config.ts",
        "src/extension/lib/**/*.ts"
    ]
}
