{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "node",
            "vscode"
        ]
    },
    "include": [
        "test/**/*.ts",
        "src/server/**/*.ts",
        "src/shared/**/*.ts",
        "src/web/lib/**/*.ts",
        "src/web/i18n/**/*.ts",
        "src/web/services/**/*.ts",
        "src/web/composables/**/*.ts",
        "src/web/components/DiffCode.vue",
        "src/web/components/CommentItem.vue",
        "src/web/components/DescriptionTab.vue",
        "src/web/components/ConfirmButton.vue",
        "src/web/components/SafeHtml.vue",
        "src/web/components/PrHeader.vue",
        "src/web/components/BuildBadge.vue",
        "src/web/components/DiffFile.vue",
        "src/web/components/DiffHunk.vue",
        "src/web/components/Composer.vue",
        "src/web/components/ThreadCard.vue",
        "src/web/components/I18nText.vue",
        "vite.config.ts",
        "vitest.config.ts",
        "src/extension/**/*.ts"
    ]
}
