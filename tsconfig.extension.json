{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "composite": true,
        "noEmit": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.extension.tsbuildinfo",
        "lib": ["ES2023"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": ["node", "vscode"]
    },
    "include": ["src/extension/**/*.ts", "src/server/**/*.ts", "src/shared/**/*.ts"]
}
